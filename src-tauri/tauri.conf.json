{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Estilográfica",
  "mainBinaryName": "estilografica",
  "version": "0.1.0",
  "identifier": "ink.wakil.estilografica",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Estilográfica - simply write!",
        "width": 1100,
        "height": 720,
        "minWidth": 560,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "msi",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Markdown notes, nothing more",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Wakil",
    "copyright": "© 2026 Wakil",
    "homepage": "https://github.com/ItsWakil"
  }
}
